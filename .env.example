# ==============================================================================
# Environment Configuration - Docker & Container Virtualization Micro Project
# ==============================================================================

# Security
SECRET_KEY=django-insecure-docker-virtualization-demo-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx,0.0.0.0

# Port Configuration
NGINX_PORT=8088

# Database Mode (Leave DB_NAME blank or set DB_ENGINE=sqlite3 for local zero-config SQLite)
# For Docker Compose, MySQL 8.0 container is used automatically.
DB_ENGINE=mysql
DB_NAME=employee_db
DB_USER=ems_user
DB_PASSWORD=ems_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword

# TiDB Cloud (Optional SSL)
# TIDB_SSL_CA=/path/to/ca.pem

